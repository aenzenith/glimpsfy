{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every Glimpsfy window: the overlays, the toast, the editor, the recorder bars, the popover, history, settings, first run and pins",
  "windows": ["overlay-*", "toast", "editor", "recorder", "rec-*", "popover", "history", "settings", "firstrun", "pin-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show"
  ]
}
